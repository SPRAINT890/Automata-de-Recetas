/* ---- sandwich.cup ---- */
import java.util.*;
import java_cup.runtime.*;
import java.io.*;

parser code {:
  public String result;
  public Recetario recetario;
  
  public static class Ingrediente {
    public String nombre; 
    public String cantidad; 
    public String unidad; 
    public boolean agusto;
    
    public Ingrediente(String n, String c, String u) { 
      nombre=n; cantidad=c; unidad=u; 
    }
    public Ingrediente(String n) { 
      nombre=n; agusto=true; 
    }
  }
  
  public static class Receta {
    public String titulo;
    public List<Ingrediente> ings = new ArrayList<>();
    public List<String> pasos = new ArrayList<>();
    public String tiempo, porciones, calorias, origen, dificultad, tipo, obs;
    public List<String> categorias = new ArrayList<>();
    public List<String> relacionadas = new ArrayList<>();
  }
  
  public static class Recetario {
    public List<Receta> recetas = new ArrayList<>();
  }
:};

action code {:
:};

/* -------- tokens -------- */
terminal RECETA, INGREDIENTES, PASOS, TIEMPO, PORCIONES, CALORIAS, CATEGORIAS, ORIGEN, DIFICULTAD, TIPO, RELACIONADAS, OBS;
terminal CARRITO, MENU, RECETAS_LISTA, PERSONAS;
terminal LBRACK, RBRACK, COMA, DOSP, NL, IGUAL;
terminal String STRING, CANTIDAD, UNIDAD, WORD, TEXT, STEPNUM, AGUSTO, ESTRELLAS, TIEMPO_VAL, METADATA_KEY, METADATA_VALUE;

/* -------- no terminales -------- */
non terminal parser.Recetario archivo;
non terminal parser.Receta receta;
non terminal List<String> categorias, valor_listastring;
non terminal List<parser.Ingrediente> lista_ings;
non terminal List<String> lista_pasos;
non terminal parser.Ingrediente ing;
non terminal String nombre, texto_linea, valor_linea;
non terminal campos_opcionales, campo_opcional;

start with archivo;

/* -------- gramática -------- */

archivo ::=
      archivo:a receta:r           {: a.recetas.add(r); parser.recetario = a; RESULT = a; :}
    | receta:r                     {: parser.Recetario rec = new parser.Recetario(); rec.recetas.add(r); parser.recetario = rec; RESULT = rec; :}
    ;

receta ::=
      RECETA STRING:t NL
      INGREDIENTES NL
      lista_ings:li
      PASOS NL
      lista_pasos:lp
      campos_opcionales
      {:
         parser.Receta r = new parser.Receta();
         r.titulo = t;
         r.ings.addAll(li);
         r.pasos.addAll(lp);
         r.tiempo = "No especificado";
         r.porciones = "No especificado";
         r.calorias = "No especificado";
         r.origen = "No especificado";
         r.dificultad = "No especificado";
         r.tipo = "No especificado";
         r.obs = "Sin observaciones";
         
         StringBuilder sb = new StringBuilder();
         sb.append("RECETA: ").append(r.titulo).append("\n");
         sb.append("INGREDIENTES:\n");
         for (parser.Ingrediente ing : r.ings) {
           if (ing.agusto) {
             sb.append("- ").append(ing.nombre).append(" a gusto\n");
           } else {
             sb.append("- ").append(ing.nombre).append(" ").append(ing.cantidad).append(" ").append(ing.unidad).append("\n");
           }
         }
         sb.append("PASOS:\n");
         for (int i = 0; i < r.pasos.size(); i++) {
           sb.append((i+1)).append(". ").append(r.pasos.get(i)).append("\n");
         }
         parser.result = sb.toString();
         
         RESULT = r;
      :}
    ;

lista_ings ::=
      lista_ings:l ing:i           {: l.add(i); RESULT = l; :}
    | ing:i                        {: List<parser.Ingrediente> l=new ArrayList<>(); l.add(i); RESULT=l; :}
    ;

ing ::=
      nombre:n CANTIDAD:c UNIDAD:u NL   {: RESULT = new parser.Ingrediente(n, c, u); :}
    | nombre:n AGUSTO NL                {: RESULT = new parser.Ingrediente(n); :}
    ;

lista_pasos ::=
      lista_pasos:l STEPNUM:s texto_linea:t  {: l.add(t); RESULT=l; :}
    | STEPNUM:s texto_linea:t                {: List<String> l=new ArrayList<>(); l.add(t); RESULT=l; :}
    ;

nombre ::=
      nombre:a WORD:b                 {: RESULT = a + " " + b; :}
    | WORD:w                          {: RESULT = w; :}
    ;

texto_linea ::= TEXT:t NL             {: RESULT = t; :} ;
valor_linea ::= TEXT:t NL             {: RESULT = t; :} ;

categorias ::=
      categorias:cs COMA WORD:w       {: cs.add(w); RESULT = cs; :}
    | WORD:w                          {: List<String> l=new ArrayList<>(); l.add(w); RESULT=l; :}
    ;

valor_listastring ::=
      STRING:s NL                         {: List<String> l=new ArrayList<>(); l.add(s); RESULT=l; :}
    | valor_listastring:ls COMA STRING:s  {: ls.add(s); RESULT=ls; :}
    ;

campos_opcionales ::=
      campos_opcionales campo_opcional    {: /* skip optional fields */ :}
    | /* empty */                         {: /* allow no optional fields */ :}
    ;

campo_opcional ::=
      TIEMPO valor_linea                  {: /* skip */ :}
    | PORCIONES valor_linea               {: /* skip */ :}
    | CALORIAS valor_linea                {: /* skip */ :}
    | CATEGORIAS LBRACK categorias RBRACK NL  {: /* skip */ :}
    | ORIGEN valor_linea                  {: /* skip */ :}
    | DIFICULTAD valor_linea              {: /* skip */ :}
    | TIPO valor_linea                    {: /* skip */ :}
    | RELACIONADAS valor_listastring      {: /* skip */ :}
    | OBS valor_linea                     {: /* skip */ :}
    ;